# ============================================
# TECHNOCRAZY — SISTEMA AVATAR IA
# Variables de Entorno para n8n
# ============================================
# INSTRUCCIÓN: Configura estas variables en:
# n8n → Settings → Environment Variables
# O en el archivo .env de tu instancia n8n
# ============================================

# --- ANTHROPIC (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- HEYGEN (Avatar Video) ---
HEYGEN_API_KEY=...
HEYGEN_AVATAR_ID=...   # Se obtiene después de crear el Digital Twin
# Para crear el Digital Twin: heygen.com → Avatars → Create → Video foto

# --- ELEVENLABS (Voz clonada de Rafael) ---
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...   # Se obtiene después de clonar la voz de Rafael

# --- OPENAI (Imágenes con ChatGPT) ---
OPENAI_API_KEY=sk-...

# --- BLOTATO (Publicación multi-plataforma) ---
# blotato.com → Settings → API Key
BLOTATO_API_KEY=...

# --- GOOGLE DRIVE (Almacenamiento de videos) ---
# Configurar via OAuth en n8n → Credentials → Google Drive
GDRIVE_FOLDER_CONTENT=...   # ID de la carpeta donde se guardan los videos

# --- GOOGLE SHEETS (Tracker de contenido) ---
SHEETS_CONTENT_TRACKER=...   # ID del Google Sheet para registrar publicaciones

# --- TELEGRAM (Notificaciones a Rafael) ---
# Crear bot con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...   # Tu chat ID personal

# ============================================
# COSTOS ESTIMADOS POR SEMANA
# ============================================
# Claude API (Opus 4.8):     ~$0.50-1.00/semana (7 planes de contenido)
# HeyGen Avatar V:           ~$21/semana (7 videos x 1 min x $3/min)
# ElevenLabs Creator:        $22/mes (~$5.50/semana incluido)
# ChatGPT imágenes:          ~$0.70/semana (7 imágenes x $0.10)
# Blotato:                   ~$15-29/mes (~$4-7/semana)
# n8n (self-hosted):         $0 (o $20/mes cloud)
# ============================================
# TOTAL ESTIMADO: ~$30-35/semana operativo
# = ~$120-140/mes para contenido ILIMITADO
# ============================================
